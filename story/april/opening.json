{
	"Start": [
		{"cmd": "show_scene", "id": "school_front_morning", "transition": "instant"},
		{"cmd": "input", "prompt": "당신의 이름을 입력하세요", "warning": "이름을 입력해주세요!", "default": "강현우"},
		{"cmd": "jump", "target": "TestEvent"}
	],

	"TestEvent": [
		{"cmd": "narration", "text": "{{player.name}}, 안녕. 기능 테스트를 시작할게."},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "sua", "text": "…안녕."},
		{"cmd": "choice", "dialog": "어떻게 할까?", "choices": [
			{"text": "반갑게 인사한다", "key": "closer", "target": "Test_Closer"},
			{"text": "무시한다", "key": "farther", "target": "Test_Farther"},
			{"text": "테스트 건너뛰기", "key": "skip", "target": "Opening"}
		]}
	],

	"Test_Closer": [
		{"cmd": "dialogue", "character": "p", "text": "안녕! 반가워, 수아."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "shy"},
		{"cmd": "dialogue", "character": "sua", "text": "…어, 반가워."},
		{"cmd": "set_var", "path": "distance", "value": 10, "op": "sub"},
		{"cmd": "affinity_hint", "character": "closer"},
		{"cmd": "narration", "text": "(거리감이 줄어든 것 같다. distance -10 적용 확인)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "jump", "target": "TestEvent"}
	],

	"Test_Farther": [
		{"cmd": "dialogue", "character": "p", "text": "……"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "sad"},
		{"cmd": "dialogue", "character": "sua", "text": "…그래."},
		{"cmd": "set_var", "path": "distance", "value": 10, "op": "add"},
		{"cmd": "affinity_hint", "character": "farther"},
		{"cmd": "narration", "text": "(거리감이 늘어난 것 같다. distance +10 적용 확인)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "jump", "target": "TestEvent"}
	],

	"Opening": [
		{"cmd": "show_scene", "id": "school_front_morning", "transition": "instant"},
		{"cmd": "play_music", "id": "piano-calm"},
		{"cmd": "narration", "text": "어떤 사람이 갑자기 눈에 밟히기 시작하는 건,"},
		{"cmd": "narration", "text": "대단한 이유가 있어서가 아닌 경우가 대부분이다."},
		{"cmd": "fade_scene", "id": "classroom_morning", "duration": 1.5},
		{"cmd": "narration", "text": "특별한 계기가 있었던 것도 아니고."},
		{"cmd": "narration", "text": "처음 봤을 때부터 인상적이었던 것도 아니다."},
		{"cmd": "narration", "text": "그냥, 시선이 갔다."},
		{"cmd": "narration", "text": "그게 전부였다."},
		{"cmd": "fade_scene", "id": "classroom_day", "duration": 1.0},
		{"cmd": "play_sound", "id": "classroom-noise"},
		{"cmd": "jump", "target": "Prologue_Gaze"}
	],

	"Prologue_Gaze": [
		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "야 근데 어제 그 판, 진짜 말도 안 됐지 않냐. 막판에 뒤집힐 줄 누가 알았겠어."},
		{"cmd": "dialogue", "character": "p", "text": "알아, 나도 거기서 그냥 끌 뻔했는데."},
		{"cmd": "dialogue", "character": "friend", "text": "근데 안 끄고 한 판 더 한 거지?"},
		{"cmd": "dialogue", "character": "p", "text": "어, 끊기가 애매해서."},
		{"cmd": "dialogue", "character": "friend", "text": "그래서? 이긴 거야?"},
		{"cmd": "dialogue", "character": "p", "text": "아니, 졌어."},
		{"cmd": "dialogue", "character": "friend", "text": "뭐야, 그럼 더 한 의미가 없잖아."},
		{"cmd": "dialogue", "character": "p", "text": "그러니까."},
		{"cmd": "dialogue", "character": "friend", "text": "오늘 저녁에 또 할 거지?"},
		{"cmd": "dialogue", "character": "p", "text": "당연하지—"},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},
		{"cmd": "narration", "text": "말하다 말고 시선이 옆으로 흘러간다."},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "(이수아.)"},
		{"cmd": "narration", "text": "(작년에도 같은 반이었다. 근데 그때는 이 애, 거의 본 적이 없었던 것 같다.)"},
		{"cmd": "narration", "text": "(쉬는 시간마다, 점심시간마다 어딘가로 사라졌으니까.)"},
		{"cmd": "narration", "text": "(다른 반에 친구가 있었나. 솔직히 관심을 가져본 적이 없어서 모르겠다.)"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "sad"},
		{"cmd": "narration", "text": "(근데 올해는.)"},
		{"cmd": "narration", "text": "(항상, 혼자다.)"},
		{"cmd": "stop_sound"},
		{"cmd": "stop_music", "fade": 2.0},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "fade_jump", "target": "Prologue_Observation", "duration": 1.5}
	],

	"Prologue_Observation": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "narration", "text": "다음 날 점심시간."},
		{"cmd": "narration", "text": "(…같은 자리, 같은 자세.)"},
		{"cmd": "show_character", "id": "sua", "sprite": "sad", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "다들 급식실로 빠져나가는 와중에 혼자 남아 있는 것까지 똑같다."},
		{"cmd": "narration", "text": "(마치 어제의 장면을 복사해서 붙여넣기 한 것 같다.)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},

		{"cmd": "fade_scene", "id": "classroom_day", "duration": 0.8},
		{"cmd": "narration", "text": "그다음 날. 급식실에서 돌아오는 길."},
		{"cmd": "show_character", "id": "sua", "sprite": "sad", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "수아의 뒷모습. 텅 빈 교실 창가에 혼자 앉아, 도시락 뚜껑을 이미 덮고 멍하니 창밖을 보고 있다."},
		{"cmd": "narration", "text": "(아, 또 혼자구나.)"},
		{"cmd": "narration", "text": "(…'또'라고 했다. 나는 이미 패턴을 인식하고 있다.)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},

		{"cmd": "fade_scene", "id": "classroom_day", "duration": 0.8},
		{"cmd": "play_sound", "id": "rain"},
		{"cmd": "narration", "text": "또 다른 날. 비가 오는 점심시간."},
		{"cmd": "narration", "text": "교실이 평소보다 어둡다. 창문에 빗방울이 흘러내린다."},
		{"cmd": "show_character", "id": "sua", "sprite": "sad", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "수아, 창가에 앉아 젓가락을 쥔 채 잠깐 창밖을 바라보다가, 다시 고개를 숙인다."},
		{"cmd": "narration", "text": "(그 몇 초간의 동작이 묘하게 선명하게 남았다.)"},
		{"cmd": "stop_sound"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "jump", "target": "Prologue_Awareness"}
	],

	"Prologue_Awareness": [
		{"cmd": "fade_scene", "id": "classroom_day", "duration": 0.8},
		{"cmd": "play_music", "id": "piano-calm"},
		{"cmd": "narration", "text": "그쯤 되니까 인정해야 했다."},
		{"cmd": "narration", "text": "나는 이 애를 보고 있다."},
		{"cmd": "narration", "text": "(점심시간이 시작되면 무의식적으로 창가 쪽을 한 번 보게 됐다. 확인하듯이.)"},
		{"cmd": "narration", "text": "(볼 때마다 달라지는 게 없었다. 매일 같은 자리, 같은 자세.)"},
		{"cmd": "narration", "text": "(누군가 말을 거는 것도, 수아가 누군가를 부르는 것도 본 적이 없다.)"},
		{"cmd": "narration", "text": "(서로에게 존재하지 않는 것처럼.)"},
		{"cmd": "narration", "text": "(작년에는 항상 어딘가 가 있던 애가, 올해는 항상 여기 있다.)"},
		{"cmd": "narration", "text": "(그리고 그 '여기'에 그 애 말고는 아무도 없다.)"},
		{"cmd": "narration", "text": "(…왜 자꾸 신경이 쓰이는지 나도 모르겠다.)"},
		{"cmd": "narration", "text": "(안쓰러운 것도 아니고, 도와줘야겠다는 사명감 같은 건 더더욱 아니다.)"},
		{"cmd": "narration", "text": "(내가 끼어들 이유가 없다.)"},

		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "…야, 듣고 있어?"},
		{"cmd": "dialogue", "character": "p", "text": "어. 들었어. 저녁에 하자고."},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},

		{"cmd": "narration", "text": "(수아는 반찬을 하나 집어 입에 넣고, 천천히 씹고 있었다.)"},
		{"cmd": "narration", "text": "(오늘 도시락에는 뭐가 들어 있을까 — 라고 생각한 자신이 좀 이상했다.)"},
		{"cmd": "narration", "text": "(여기서 보이는 건 뒷모습뿐이라 도시락 안은 보이지도 않는데.)"},

		{"cmd": "show_character", "id": "sua", "sprite": "sad", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "수아가 갑자기 도시락 뚜껑을 덮는다. 꺼낸 지 얼마 되지도 않았는데."},
		{"cmd": "narration", "text": "젓가락을 도시락통 옆에 내려놓고, 두 손을 무릎 위에 가지런히 올린다."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "narration", "text": "수아가 아주 잠깐 — 교실을 둘러본다."},
		{"cmd": "narration", "text": "급식실에서 돌아와 삼삼오오 모여 떠들고, 웃고 있는 아이들을."},
		{"cmd": "narration", "text": "그 풍경을 한 번 훑듯이 바라보고는, 다시 고개를 숙인다."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "sad"},

		{"cmd": "narration", "text": "(표정은 보이지 않았다. 뒷모습이니까.)"},
		{"cmd": "narration", "text": "그 동작이 — 왠지 모르게, 오래 남았다."},
		{"cmd": "narration", "text": "꺼낸 지 얼마 안 된 도시락을 덮는 손."},
		{"cmd": "narration", "text": "교실을 한 번 둘러보는 시선."},
		{"cmd": "narration", "text": "그리고 다시 고개를 숙이는 동작."},
		{"cmd": "narration", "text": "그 일련의 흐름이, 마치 오래전부터 반복해온 루틴처럼 자연스러웠다."},

		{"cmd": "narration", "text": "(작년에 매일 다른 반을 찾아가던 건 — 거기에 친한 애가 있었겠지.)"},
		{"cmd": "narration", "text": "(그러면 올해는? 그 친구와 어떻게 된 걸까.)"},
		{"cmd": "narration", "text": "(싸웠나. 전학을 갔나. 아니면 그냥 — 멀어진 건가.)"},
		{"cmd": "narration", "text": "(혼자가 편해서 혼자인 게 아니라.)"},
		{"cmd": "narration", "text": "(혼자가 되어버린 건 아닐까.)"},
		{"cmd": "narration", "text": "(…내가 뭘 안다고. 만나본 적도, 말해본 적도 없는 애 사정을 멋대로 추측하는 건 좀 아니지.)"},
		{"cmd": "narration", "text": "(그래. 신경 끄자.)"},

		{"cmd": "narration", "text": "고개를 돌리려다 — 다시 본다."},
		{"cmd": "narration", "text": "수아, 도시락 뚜껑을 덮은 채 가만히 앉아 있다."},
		{"cmd": "narration", "text": "(가만히 앉아 있으면 평소처럼 지나간다. 오늘도, 내일도.)"},
		{"cmd": "narration", "text": "(근데 — 오늘은 왠지 그게 마음에 안 들었다.)"},

		{"cmd": "play_sound", "id": "chair-drag"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "stop_music", "fade": 2.0},
		{"cmd": "fade_jump", "target": "Chapter1_Approach", "duration": 1.5}
	],

	"Chapter1_Approach": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "play_music", "id": "daily-life"},
		{"cmd": "play_sound", "id": "classroom-noise"},
		{"cmd": "narration", "text": "다음 날 점심시간."},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "(평소처럼 친구랑 급식실에 갈 생각이었다.)"},
		{"cmd": "narration", "text": "(근데 일어서는 순간, 발이 급식실 쪽이 아니라 창가 쪽으로 향했다.)"},
		{"cmd": "narration", "text": "(왜 그쪽으로 갔냐고 물으면 대답할 말이 마땅치 않다.)"},
		{"cmd": "narration", "text": "(\"저 애가 혼자라서\"는 너무 거창하고, \"그냥\"은 너무 성의 없다.)"},
		{"cmd": "narration", "text": "(근데 진짜로, '그냥'이었다.)"},
		{"cmd": "narration", "text": "(머리가 판단하기 전에 몸이 먼저 움직인 거다.)"},

		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "left", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "어, 어디 가? 급식실 저쪽인데."},
		{"cmd": "dialogue", "character": "p", "text": "잠깐."},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},

		{"cmd": "narration", "text": "(뭐라고 말을 걸지도 정하지 않았다. 그냥 갔다.)"},
		{"cmd": "stop_sound"},
		{"cmd": "dialogue", "character": "p", "text": "저기."},
		{"cmd": "narration", "text": "수아는 반응이 없다. 못 들은 건지, 자기한테 하는 말인지 모르는 건지."},
		{"cmd": "dialogue", "character": "p", "text": "저기, 이수아."},

		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "narration", "text": "수아가 고개를 든다. 눈이 생각보다 크다. 까만 눈동자가 올려다보고 있다."},
		{"cmd": "narration", "text": "'왜 내 이름을 알고 있지'와 '왜 나한테 말을 거는 거지'가 한꺼번에 지나가는 표정."},

		{"cmd": "dialogue", "character": "sua", "text": "…나?"},
		{"cmd": "dialogue", "character": "p", "text": "어."},

		{"cmd": "play_sound", "id": "chair-drag"},
		{"cmd": "narration", "text": "한 박자. 뭐라고 할까 잠깐 고민하다가 — 고민하는 게 귀찮아져서, 그냥 맞은편 의자를 끌고 앉는다."},

		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "narration", "text": "수아의 젓가락이 멈춘다. 아무 말 없이, 1초, 2초."},

		{"cmd": "change_sprite", "id": "sua", "sprite": "worried"},
		{"cmd": "dialogue", "character": "sua", "text": "…볼일 있어?"},
		{"cmd": "dialogue", "character": "p", "text": "아니, 그냥 여기서 밥 먹으려고."},

		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "dialogue", "character": "sua", "text": "…여기서?"},
		{"cmd": "dialogue", "character": "p", "text": "어."},

		{"cmd": "change_sprite", "id": "sua", "sprite": "worried"},
		{"cmd": "dialogue", "character": "sua", "text": "…여기 있어도 괜찮아?"},

		{"cmd": "narration", "text": "(그 말투가 이상했다.)"},
		{"cmd": "narration", "text": "('왜 여기서 먹는데'도, '자리 많은데 왜 하필'도 아니고 —)"},
		{"cmd": "narration", "text": "('나랑 같이 있어도 괜찮냐'였다.)"},
		{"cmd": "narration", "text": "(마치 자기가 뭔가 문제가 있는 쪽인 것처럼. 내가 손해를 보는 것처럼.)"},

		{"cmd": "dialogue", "character": "p", "text": "가끔은 조용한 곳에 있고 싶어서."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "narration", "text": "수아가 다시 현우를 본다. 뭔가 더 따질 것 같은 눈이었다가 — 조용히 고개를 숙인다."},
		{"cmd": "narration", "text": "말 대신 젓가락을 다시 집어 든다."},
		{"cmd": "narration", "text": "(그게 이 애 나름의 허락이었던 것 같다.)"},

		{"cmd": "jump", "target": "Chapter1_Lunch"}
	],

	"Chapter1_Lunch": [
		{"cmd": "play_music", "id": "warm-afternoon"},
		{"cmd": "narration", "text": "수아의 도시락통 — 하얀색. 계란말이, 김치, 작게 썬 소시지. 밥 위에 김가루가 살짝 뿌려져 있다."},
		{"cmd": "narration", "text": "계란말이가 한쪽이 좀 타 있고, 소시지 크기가 제각각이다."},
		{"cmd": "narration", "text": "(사 먹는 도시락 같지는 않다. 직접 만든 건가.)"},
		{"cmd": "narration", "text": "수아가 젓가락을 조심스럽게 움직인다. 반찬을 집을 때 꼭 한 번에 하나씩, 정확하게."},
		{"cmd": "narration", "text": "(급하지 않은데 느긋한 것도 아닌 — 자기만의 일정한 박자 같은 게 있다.)"},
