{
	"Start": [
		{"cmd": "input", "prompt": "당신의 이름을 입력하세요", "warning": "이름을 입력해주세요!"},
		{"cmd": "jump", "target": "Opening"}
	],

	"Opening": [
		{"cmd": "show_scene", "id": "#000000", "transition": "instant"},
		{"cmd": "play_music", "id": "piano-calm"},
		{"cmd": "narration", "text": "어떤 사람이 갑자기 눈에 밟히기 시작하는 건,"},
		{"cmd": "narration", "text": "대단한 이유가 있어서가 아닌 경우가 대부분이다."},
		{"cmd": "fade_scene", "id": "classroom_morning", "duration": 1.5},
		{"cmd": "narration", "text": "특별한 계기가 있었던 것도 아니고."},
		{"cmd": "narration", "text": "처음 봤을 때부터 인상적이었던 것도 아니다."},
		{"cmd": "narration", "text": "그냥, 시선이 갔다."},
		{"cmd": "narration", "text": "그게 전부였다."},
		{"cmd": "fade_scene", "id": "classroom_day", "duration": 1.0},
		{"cmd": "play_sound", "id": "classroom-noise"},
		{"cmd": "narration", "text": "작년에도 같은 반이었다."},
		{"cmd": "narration", "text": "근데 그때는 이 애, 항상 자리에 없었다."},
		{"cmd": "narration", "text": "쉬는 시간마다, 점심시간마다,"},
		{"cmd": "narration", "text": "어딘가 다른 반을 찾아가는 건지 — 늘 보이지 않았으니까."},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "그런데 올해는."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "sad"},
		{"cmd": "narration", "text": "항상, 혼자였다."},
		{"cmd": "stop_sound"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "stop_music", "fade": 2.0},
		{"cmd": "fade_jump", "target": "April_Week1", "duration": 1.5}
	],

	"April_Week1": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "play_music", "id": "daily-life"},
		{"cmd": "play_sound", "id": "classroom-noise"},
		{"cmd": "narration", "text": "4월 1주차 — 봄, 어색한 제안"},
		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "야 근데 어제 그 판, 진짜 말도 안 됐지 않냐. 막판에 뒤집힐 줄 누가 알았겠어."},
		{"cmd": "dialogue", "character": "p", "text": "알아, 나도 거기서 접을 뻔 했는데."},
		{"cmd": "dialogue", "character": "friend", "text": "오늘 저녁에 또 할 거지?"},
		{"cmd": "dialogue", "character": "p", "text": "당연하지—"},
		{"cmd": "narration", "text": "(…어?)"},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},
		{"cmd": "show_character", "id": "sua", "sprite": "sad", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "(저 애, 오늘도 혼자네.)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "야, 듣고 있어?"},
		{"cmd": "dialogue", "character": "p", "text": "어, 어. 들었어. 저녁에 하자고."},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},
		{"cmd": "narration", "text": "(작년엔 저러지 않았는데. 항상 다른 반 가있었잖아.)"},
		{"cmd": "narration", "text": "(올해는 계속 혼자 밥 먹고 있고.)"},
		{"cmd": "narration", "text": "(…뭐, 내가 신경 쓸 건 아닌데.)"},
		{"cmd": "narration", "text": "(…근데 왜 자꾸 신경 쓰이지.)"},
		{"cmd": "play_sound", "id": "chair-drag"},
		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "어, 어디 가?"},
		{"cmd": "dialogue", "character": "p", "text": "잠깐."},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},
		{"cmd": "jump", "target": "April_Week1_Approach"}
	],

	"April_Week1_Approach": [
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "p", "text": "야."},
		{"cmd": "narration", "text": "수아는 반응이 없다. 못 들은 건지 무시하는 건지."},
		{"cmd": "dialogue", "character": "p", "text": "야, 너."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "dialogue", "character": "sua", "text": "…나?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "p", "text": "어. 같이 먹을래? 응? 아니, 다른 애들이랑 몰려서 먹을 필요까진 없고. 그냥 둘이."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "worried"},
		{"cmd": "dialogue", "character": "sua", "text": "…괜찮아?"},
		{"cmd": "dialogue", "character": "p", "text": "뭐가."},
		{"cmd": "dialogue", "character": "sua", "text": "나랑 먹어도 괜찮냐고."},
		{"cmd": "dialogue", "character": "p", "text": "내가 먼저 말 걸었잖아."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "sua", "text": "…알겠어."},
		{"cmd": "narration", "text": "(뭐야, 쉽네.)"},
		{"cmd": "play_sound", "id": "tray-place"},
		{"cmd": "narration", "text": "(근데 왜 나한테 괜찮냐고 물어보는 거지. 내가 먼저 간 건데.)"},
		{"cmd": "jump", "target": "April_Week1_Lunch"}
	],

	"April_Week1_Lunch": [
		{"cmd": "stop_sound"},
		{"cmd": "fade_scene", "id": "lunch_spot", "duration": 1.0},
		{"cmd": "play_music", "id": "warm-afternoon"},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "근데 쉬운 게 아니었다."},
		{"cmd": "narration", "text": "두 사람, 나란히 밥을 먹는다. 아무 말도 없다."},
		{"cmd": "narration", "text": "(왜 이렇게 조용하지.)"},
		{"cmd": "narration", "text": "(내가 뭐 이상한 말이라도 했나? 기분 나쁘게 한 건 없는 것 같은데.)"},
		{"cmd": "narration", "text": "(근데 싫다는 것도 아니고. 밥은 잘 먹고 있잖아.)"},
		{"cmd": "narration", "text": "(말을 걸어야 하나. 어떻게 말을 걸지.)"},
		{"cmd": "dialogue", "character": "p", "text": "…도시락 직접 만들어온 거야?"},
		{"cmd": "dialogue", "character": "sua", "text": "…어."},
		{"cmd": "dialogue", "character": "p", "text": "집에서?"},
		{"cmd": "dialogue", "character": "sua", "text": "…응."},
		{"cmd": "dialogue", "character": "p", "text": "매일?"},
		{"cmd": "dialogue", "character": "sua", "text": "…거의."},
		{"cmd": "dialogue", "character": "p", "text": "귀찮지 않아? 아침에 만들어 오는 거."},
		{"cmd": "dialogue", "character": "sua", "text": "…우리 학교 급식 맛 없어서."},
		{"cmd": "dialogue", "character": "p", "text": "맞아. 진짜 맛없지."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "shy"},
		{"cmd": "narration", "text": "(…방금 웃었나? 아닌가. 너무 작아서 잘 모르겠다.)"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "p", "text": "근데 급식 맛있는 날엔 어떡해?"},
		{"cmd": "dialogue", "character": "sua", "text": "…급식표 미리 보고. 그날은 찾아가."},
		{"cmd": "dialogue", "character": "p", "text": "뭐가 나오면 가?"},
		{"cmd": "dialogue", "character": "sua", "text": "……짜장면."},
		{"cmd": "dialogue", "character": "p", "text": "아, 나도. 짜장면 날은 무조건이지."},
		{"cmd": "narration", "text": "(말을 못 하는 게 아니라, 어떻게 해야 하는지 모르는 것 같기도 하고.)"},
		{"cmd": "narration", "text": "(뭐, 천천히 알아가면 되겠지.)"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "stop_music", "fade": 2.0},
		{"cmd": "fade_jump", "target": "SeatAssignment", "duration": 1.5}
	],

	"SeatAssignment": [
		{"cmd": "fade_scene", "id": "classroom_day", "duration": 1.0},
		{"cmd": "play_music", "id": "daily-life"},
		{"cmd": "play_sound", "id": "classroom-noise"},
		{"cmd": "centered", "text": "자리 배정 이벤트"},
		{"cmd": "narration", "text": "며칠 후. 교실 — 선생님이 새 자리를 칠판에 적고 있다."},
		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "야, 나 앞자리 됐다. 이거 최악이다."},
		{"cmd": "dialogue", "character": "p", "text": "어디 됐는데?"},
		{"cmd": "dialogue", "character": "friend", "text": "맨 앞 가운데. 선생님 눈에 바로 띄는 자리잖아."},
		{"cmd": "dialogue", "character": "p", "text": "수업 잘 들으면 되잖아."},
		{"cmd": "dialogue", "character": "friend", "text": "야, 진심으로 말하는 거야?"},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},
		{"cmd": "stop_sound"},
		{"cmd": "narration", "text": "나는 오늘, 수아를…"},
		{"cmd": "choice", "dialog": "", "choices": [
			{"text": "취미를 묻는다", "key": "hobby", "target": "SeatAssignment_Hobby"},
			{"text": "반갑게 인사한다", "key": "greet", "target": "SeatAssignment_Greet"},
			{"text": "친구와 대화한다", "key": "friend_talk", "target": "SeatAssignment_FriendTalk"},
			{"text": "보지 않았다", "key": "ignore", "target": "SeatAssignment_Ignore"}
		]}
	],

	"SeatAssignment_Hobby": [
		{"cmd": "set_var", "path": "distance", "value": 15, "op": "sub"},
		{"cmd": "affinity_hint", "character": "closer"},
		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "narration", "text": "수아가 자리를 정리하다 가방 안에 뭔가를 슬쩍 밀어 넣는다."},
		{"cmd": "narration", "text": "(뭔가 넣었는데.)"},
		{"cmd": "dialogue", "character": "p", "text": "야, 방금 가방에 뭔가 넣지 않았어?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "dialogue", "character": "sua", "text": "…안 넣었어."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "p", "text": "진짜?"},
		{"cmd": "dialogue", "character": "sua", "text": "…진짜."},
		{"cmd": "dialogue", "character": "p", "text": "나 봤는데."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "worried"},
		{"cmd": "narration", "text": "수아는 말이 없다. 현우를 보지 않는다."},
		{"cmd": "dialogue", "character": "p", "text": "뭐야, 숨길 거 아니면 그냥 말해도 되잖아."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "shy"},
		{"cmd": "dialogue", "character": "sua", "text": "……책이야. 그냥."},
		{"cmd": "dialogue", "character": "p", "text": "무슨 책?"},
		{"cmd": "dialogue", "character": "sua", "text": "…그냥 소설."},
		{"cmd": "dialogue", "character": "p", "text": "어떤 소설?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "sua", "text": "……보여줄게."},
		{"cmd": "narration", "text": "수아가 망설이다 가방에서 책을 꺼낸다. 표지가 눈에 띄게 화려한 로맨스 소설."},
		{"cmd": "dialogue", "character": "p", "text": "…《달빛 아래 우산》?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "shy"},
		{"cmd": "dialogue", "character": "sua", "text": "…유명한 거야."},
		{"cmd": "dialogue", "character": "p", "text": "들어본 것 같기도 하고. 아닌 것 같기도 하고.\n재밌어?"},
		{"cmd": "dialogue", "character": "sua", "text": "…재밌어."},
		{"cmd": "narration", "text": "(숨기려던 거 맞는데, 물어보니까 다 대답하네. 조심스러운 거지, 싫은 건 아닌가.)"},
		{"cmd": "dialogue", "character": "p", "text": "어떤 내용이야?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "dialogue", "character": "sua", "text": "……두 사람이 계속 엇갈리는 얘기."},
		{"cmd": "dialogue", "character": "p", "text": "엇갈려? 왜?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "normal"},
		{"cmd": "dialogue", "character": "sua", "text": "……읽어보면 알아."},
		{"cmd": "narration", "text": "(권유하는 건가, 거절하는 건가.)"},
		{"cmd": "dialogue", "character": "p", "text": "나한테 빌려줄 수 있어?"},
		{"cmd": "change_sprite", "id": "sua", "sprite": "surprised"},
		{"cmd": "dialogue", "character": "sua", "text": "……다 읽으면."},
		{"cmd": "dialogue", "character": "p", "text": "얼마나 남았어?"},
		{"cmd": "dialogue", "character": "sua", "text": "……반쯤."},
		{"cmd": "dialogue", "character": "p", "text": "빨리 읽어."},
		{"cmd": "change_sprite", "id": "sua", "sprite": "shy"},
		{"cmd": "narration", "text": "수아가 말없이 책을 가방에 다시 넣는다. 하지만 표정이 조금 전보다 묘하게 부드러워져 있다."},
		{"cmd": "narration", "text": "(책 빌리려던 건 아닌데. 그냥 말이 이어졌다.)"},
		{"cmd": "jump", "target": "SeatAssignment_SecondChoice"}
	],

