		{"cmd": "narration", "text": "색상 배경 테스트 (#RRGGBBAA 형식)"},
		{"cmd": "show_scene", "id": "#000000FF", "transition": "instant"},
		{"cmd": "narration", "text": "검은 화면 (색상 배경)"},

		{"cmd": "show_scene", "id": "#1a237eff", "transition": "instant"},
		{"cmd": "narration", "text": "진한 남색 화면"},

		{"cmd": "narration", "text": "다시 일반 배경으로 복귀"},
		{"cmd": "show_scene", "id": "classroom_day", "transition": "fadeIn"},
		{"cmd": "narration", "text": "[배경 전환 테스트 완료]"},
		{"cmd": "jump", "target": "TestMenu2"}
	],

