	"Test_Variable": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "centered", "text": "— 변수/조건 분기 테스트 —"},

		{"cmd": "narration", "text": "=== set_var 테스트 ==="},

		{"cmd": "narration", "text": "distance를 50으로 설정 (set)"},
		{"cmd": "set_var", "path": "distance", "value": 50, "op": "set"},

		{"cmd": "narration", "text": "distance에서 20 빼기 (sub) → 30"},
		{"cmd": "set_var", "path": "distance", "value": 20, "op": "sub"},

		{"cmd": "narration", "text": "distance에 5 더하기 (add) → 35"},
		{"cmd": "set_var", "path": "distance", "value": 5, "op": "add"},

		{"cmd": "narration", "text": "april_events를 0으로 초기화"},
		{"cmd": "set_var", "path": "april_events", "value": 0, "op": "set"},

		{"cmd": "narration", "text": "april_events +1"},
		{"cmd": "set_var", "path": "april_events", "value": 1, "op": "add"},

		{"cmd": "narration", "text": "=== conditional 테스트 ==="},
		{"cmd": "narration", "text": "현재 distance = 35. 조건: distance <= 40 → Close, 아니면 Far"},
		{"cmd": "conditional", "branches": [
			{"condition": "distance <= 40", "action": "jump", "target": "Test_Cond_Close"}
		], "default": "Test_Cond_Far"},

		{"cmd": "narration", "text": "이 줄은 보이면 안 됩니다 (conditional 뒤)"}
	],

	"Test_Cond_Close": [
		{"cmd": "narration", "text": "✓ 조건 분기 성공: distance <= 40 → Close 분기 진입"},
		{"cmd": "jump", "target": "Test_Cond_And"}
	],

	"Test_Cond_Far": [
		{"cmd": "narration", "text": "✗ 조건 분기 실패: Far 분기에 진입함 (distance가 40 이하인데?)"},
		{"cmd": "jump", "target": "Test_Cond_And"}
	],

	"Test_Cond_And": [
		{"cmd": "narration", "text": "=== AND 복합 조건 테스트 ==="},
		{"cmd": "narration", "text": "조건: distance <= 40 AND april_events >= 1"},
		{"cmd": "conditional", "branches": [
			{"condition": "distance <= 40 AND april_events >= 1", "action": "jump", "target": "Test_Cond_AndPass"}
		], "default": "Test_Cond_AndFail"}
	],

	"Test_Cond_AndPass": [
		{"cmd": "narration", "text": "✓ AND 조건 성공: 두 조건 모두 참"},
		{"cmd": "jump", "target": "Test_Cond_Or"}
	],

	"Test_Cond_AndFail": [
		{"cmd": "narration", "text": "✗ AND 조건 실패"},
		{"cmd": "jump", "target": "Test_Cond_Or"}
	],

	"Test_Cond_Or": [
		{"cmd": "narration", "text": "=== OR 복합 조건 테스트 ==="},
		{"cmd": "narration", "text": "조건: distance > 100 OR april_events >= 1 (왼쪽 거짓, 오른쪽 참)"},
		{"cmd": "conditional", "branches": [
			{"condition": "distance > 100 OR april_events >= 1", "action": "jump", "target": "Test_Cond_OrPass"}
		], "default": "Test_Cond_OrFail"}
	],

	"Test_Cond_OrPass": [
		{"cmd": "narration", "text": "✓ OR 조건 성공: 하나 이상 참"},
		{"cmd": "narration", "text": "[변수/조건 분기 테스트 완료]"},
		{"cmd": "jump", "target": "TestMenu2"}
	],

	"Test_Cond_OrFail": [
		{"cmd": "narration", "text": "✗ OR 조건 실패"},
		{"cmd": "narration", "text": "[변수/조건 분기 테스트 완료]"},
		{"cmd": "jump", "target": "TestMenu2"}
	],

