{
	"Start": [
		{"cmd": "show_scene", "id": "school_front_morning", "transition": "instant"},
		{"cmd": "input", "prompt": "당신의 이름을 입력하세요", "warning": "이름을 입력해주세요!", "default": "강현우"},
		{"cmd": "jump", "target": "TestMenu"}
	],

	"TestMenu": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "centered", "text": "— 기능 테스트 메뉴 —"},
		{"cmd": "narration", "text": "{{player.name}}, 테스트할 기능을 선택해."},
		{"cmd": "choice", "dialog": "어떤 기능을 테스트할까?", "choices": [
			{"text": "1. 대화/내레이션/센터 텍스트", "key": "text", "target": "Test_Text"},
			{"text": "2. 배경 전환 (트랜지션)", "key": "scene", "target": "Test_Scene"},
			{"text": "3. 캐릭터 표시/숨김/애니메이션", "key": "char", "target": "Test_Character"},
			{"text": "4. 오디오 (음악/효과음)", "key": "audio", "target": "Test_Audio"}
		]}
	],

	"TestMenu2": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "choice", "dialog": "다음 테스트를 선택해.", "choices": [
			{"text": "5. 변수/조건 분기", "key": "var", "target": "Test_Variable"},
			{"text": "6. 페이드/점프/대기", "key": "fade", "target": "Test_FadeJump"},
			{"text": "7. 갤러리/어피니티/방해금지", "key": "special", "target": "Test_Special"},
			{"text": "8. 전체 통합 테스트 (스토리)", "key": "full", "target": "Opening"}
		]}
	],

	"Test_Text": [
		{"cmd": "show_scene", "id": "classroom_day", "transition": "instant"},
		{"cmd": "centered", "text": "— 텍스트 기능 테스트 —"},

		{"cmd": "narration", "text": "이것은 내레이션입니다. 3인칭 서술에 사용됩니다."},
		{"cmd": "narration", "text": "플레이어 이름 치환 테스트: {{player.name}}"},

		{"cmd": "show_character", "id": "sua", "sprite": "normal", "position": "center", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "sua", "text": "이것은 수아의 대사입니다. 이름과 색상이 표시됩니다."},

		{"cmd": "show_character", "id": "p", "sprite": "normal", "position": "left", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "p", "text": "이것은 플레이어 대사입니다. 이름이 {{player.name}}으로 표시됩니다."},

		{"cmd": "show_character", "id": "friend", "sprite": "normal", "position": "right", "transition": "fadeIn"},
		{"cmd": "dialogue", "character": "friend", "text": "이것은 친구 대사입니다."},

		{"cmd": "hide_character", "id": "p", "transition": "fadeOut"},
		{"cmd": "hide_character", "id": "sua", "transition": "fadeOut"},
		{"cmd": "hide_character", "id": "friend", "transition": "fadeOut"},

		{"cmd": "centered", "text": "센터 텍스트는 화면 중앙에 표시됩니다."},
		{"cmd": "centered", "text": "장면 전환이나 시간 경과를 나타낼 때 사용합니다."},

		{"cmd": "narration", "text": "[텍스트 테스트 완료]"},
		{"cmd": "jump", "target": "TestMenu2"}
	],

	"Test_Scene": [
		{"cmd": "centered", "text": "— 배경 전환 테스트 —"},

